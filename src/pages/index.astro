---
import PageLayout from "@/layouts/Base";
import PostPreview from "@/components/blog/PostPreview";
import SocialList from "@/components/SocialList";
import { getAllPosts, sortMDByDate } from "@/utils";

const MAX_POSTS = 10;
const allPosts = await getAllPosts();
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS);
---

<PageLayout meta={{ title: "Home" }}>
	<section>
		<p class="mb-4">
			i'm currently a software engineer in NY experimenting with learning and education on gemini. previously, i worked on the accessibility team for google docs, sheets and slides, where my colleagues and i presented at <a class="cactus-link" href="https://www.nad.org/sf26/" target="_blank" rel="noopener noreferrer">the NAD conference</a>. broadly, i am interested in creating delightful, accessible user experiences that empower humans to learn and be creative.
		</p>
		<SocialList />
	</section>
	<section aria-label="Blog post list" class="mt-[3.125rem]">
		<h2 class="title mb-4 text-xl">Posts</h2>
		<ul class="space-y-4 sm:space-y-2">
			{
				allPostsByDate.map((p) => (
					<li class="flex flex-col gap-x-2 sm:flex-row">
						<PostPreview post={p} />
					</li>
				))
			}
		</ul>
	</section>
</PageLayout>
